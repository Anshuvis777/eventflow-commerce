{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eventflowcommerce/common-event-envelope",
  "title": "EventEnvelope",
  "description": "Common envelope for all EventFlowCommerce Kafka business events",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "service_name", "timestamp", "severity", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique event identifier (Kafka message key)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OrderPlaced",
        "PaymentFailed",
        "PaymentSucceeded",
        "InventoryReleased",
        "OrderCancelled",
        "ShipmentCreated",
        "ShipmentDelivered"
      ]
    },
    "correlation_id": {
      "type": "string",
      "description": "Business correlation ID grouping related events across services"
    },
    "service_name": {
      "type": "string",
      "description": "Name of the originating service"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of event occurrence"
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Business severity of the event"
    },
    "payload": {
      "type": "object",
      "description": "Event-type-specific payload"
    },
    "metadata": {
      "type": "object",
      "description": "Optional additional metadata (trace IDs, etc.)",
      "properties": {
        "trace_id": { "type": "string" },
        "span_id": { "type": "string" },
        "parent_event_id": { "type": "string", "format": "uuid" },
        "retry_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
