{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eventflowcommerce/inventory-released",
  "title": "InventoryReleased",
  "description": "Emitted when reserved inventory is released back to available stock — failure event that triggers incident creation",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "service_name", "timestamp", "severity", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "InventoryReleased" },
    "correlation_id": { "type": "string" },
    "service_name": { "const": "inventory-service" },
    "timestamp": { "type": "string", "format": "date-time" },
    "severity": { "const": "MEDIUM" },
    "payload": {
      "type": "object",
      "required": ["order_id", "items", "release_reason"],
      "properties": {
        "order_id": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["product_id", "quantity"],
            "properties": {
              "product_id": { "type": "string" },
              "product_name": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "warehouse_id": { "type": "string" }
            }
          }
        },
        "release_reason": {
          "type": "string",
          "enum": ["PAYMENT_FAILED", "ORDER_CANCELLED", "TIMEOUT", "MANUAL_OVERRIDE"]
        },
        "released_by": { "type": "string", "description": "User or system that triggered release" }
      }
    }
  }
}
