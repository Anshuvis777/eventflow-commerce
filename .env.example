# ══════════════════════════════════════════════════════════════
# EventFlow Commerce - Cloud Infrastructure Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Docker Compose reads this file from docker/ via env_file: ../.env

# ─── Neon PostgreSQL (Serverless) ─────────────────────────
NEON_HOST=ep-solitary-river-ax384abl-pooler.c-4.us-east-2.aws.neon.tech
NEON_USER=neondb_owner
NEON_PASSWORD=your_neon_password

# ─── Aiven Kafka ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=your-kafka-cluster.aivencloud.com:25117
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_aiven_password

# ─── Redis Cloud ──────────────────────────────────────────
REDIS_HOST=your-redis-instance.db.redis.io
REDIS_PORT=17513
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# ─── Mailtrap SMTP (notification-service) ───────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@eventflow.com

# ─── Gemini AI (for incident-analyzer root cause) ─────────
GEMINI_API_KEY=your_gemini_api_key

# ─── ChromaDB (for incident-query similar incidents) ──────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
